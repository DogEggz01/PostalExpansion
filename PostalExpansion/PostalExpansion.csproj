<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PostalExpansion</AssemblyName>
    <RootNamespace>PostalExpansion</RootNamespace>
		<Version>1.1.1</Version>
		<AssemblyVersion>1.1.1.0</AssemblyVersion>
		<FileVersion>1.1.1.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\Sailwind\</GameDir>
    <InstallToSailwind Condition="'$(InstallToSailwind)' == ''">false</InstallToSailwind>
    <PostalExpansionInstallDir>$(GameDir)BepInEx\plugins\PostalExpansion</PostalExpansionInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\express_mail_seal.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\registered_letter_seal.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)Sailwind_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)Sailwind_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="InstallToSailwind" AfterTargets="Build" Condition="'$(InstallToSailwind)' == 'true'">
    <MakeDir Directories="$(PostalExpansionInstallDir)" />
    <MakeDir Directories="$(PostalExpansionInstallDir)\assets" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PostalExpansionInstallDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(PostalExpansionInstallDir)"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="assets\express_mail_seal.png"
          DestinationFolder="$(PostalExpansionInstallDir)\assets" />
    <Copy SourceFiles="assets\registered_letter_seal.png"
          DestinationFolder="$(PostalExpansionInstallDir)\assets" />
    <Copy SourceFiles="README.md"
          DestinationFolder="$(PostalExpansionInstallDir)" />
  </Target>
</Project>
